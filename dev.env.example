# Local settings. Copy to dev.env (not in git), edit the path, then: source dev.env
# Working folder for the downloads (inputs/) and the outputs: about 170 GB for Belgium, 280 GB while the Walloon ZIPs
# are still there (they can be deleted once unpacked).
export BELGIUM_LIDAR_WORK_DIR="/path/to/belgium-lidar-work"
export OMP_NUM_THREADS=8     # threads per process for numpy/scipy
